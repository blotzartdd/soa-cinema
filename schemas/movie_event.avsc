{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "com.cinema.events",
  "doc": "Event generated by user interactions in online cinema",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "UUID unique event identifier"
    },
    {
      "name": "user_id",
      "type": "string",
      "doc": "User identifier"
    },
    {
      "name": "movie_id",
      "type": "string",
      "doc": "Movie identifier"
    },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": ["VIEW_STARTED", "VIEW_FINISHED", "VIEW_PAUSED", "VIEW_RESUMED", "LIKED", "SEARCHED"]
      },
      "doc": "Type of user event"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Event timestamp in UTC milliseconds"
    },
    {
      "name": "device_type",
      "type": {
        "type": "enum",
        "name": "DeviceType",
        "symbols": ["MOBILE", "DESKTOP", "TV", "TABLET"]
      },
      "doc": "Device type used by the user"
    },
    {
      "name": "session_id",
      "type": "string",
      "doc": "Session identifier"
    },
    {
      "name": "progress_seconds",
      "type": "int",
      "default": 0,
      "doc": "View progress in seconds (for view events)"
    }
  ]
}